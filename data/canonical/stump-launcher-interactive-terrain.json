      "weapon",
      "barrel",
      "projectile"
    ]
  },
  "authored_placement_fields": [
    "launch_origin",
    "launch_angle",
    "launch_height",
    "horizontal_displacement",
    "apex_position",
    "valid_landing_region",
    "cooldown",
    "air_steering",
    "slam_modifier",
    "failure_recovery",
    "multiplayer_resolution"
  ],
  "approved_purposes": [
    "elevated_route_access",
    "gap_crossing",
    "hidden_area_access",
