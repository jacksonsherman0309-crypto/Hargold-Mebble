{
  "schemaVersion": 1,
  "controllerPolicy": {
    "movementAuthority": "deterministic fixed-step velocity controller",
    "manualSprintAction": false,
    "locomotionSelection": "damped horizontal speed",
    "walkMaximumBeforeBlendMetresPerSecond": 4.15,
    "runMinimumMetresPerSecond": 4.15,
    "rootMotion": false,
    "missingClipPolicy": "retain the supplied bind/rest pose and preserve gameplay; do not fabricate a replacement clip"
  },
  "heroes": {
    "Hargold": {
      "clips": {
        "walk": "hargold_walk",
        "run": "hargold_run"
      }
    },
    "Mebble": {
      "clips": {
        "walk": "mebble_walk",
        "run": "mebble_run"
      }
    }
  },
  "requiredLiveStates": {
    "Idle": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "MoveStart": {
      "mapping": "{hero}_walk",
      "status": "closest-supplied-clip"
    },
    "Walk": {
      "mapping": "{hero}_walk",
      "status": "exact"
    },
    "Run": {
      "mapping": "{hero}_run",
      "status": "exact"
    },
    "MoveStop": {
      "mapping": "{hero}_walk -> rest-pose cross-fade",
      "status": "closest-supplied-clip"
    },
    "Turn": {
      "mapping": "speed-selected {hero}_walk or {hero}_run plus valid Y-axis facing rotation",
      "status": "closest-supplied-clip"
    },
    "JumpStart": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "JumpRise": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "JumpApex": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "Fall": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "Land": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "Crouch": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "Damage": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "Defeat": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    },
    "Respawn": {
      "mapping": "rest-pose",
      "status": "missing-supplied-clip"
    }
  },
  "debugOnlyClips": [],
  "suppliedClipsWithoutGameplayUse": [],
  "explicitMissingSuppliedClips": [
    "idle",
    "move-start",
    "move-stop",
    "turn",
    "jump-start",
    "jump-rise",
    "jump-apex",
    "fall",
    "land",
    "crouch",
    "damage",
    "defeat",
    "respawn",
    "attack",
    "celebration",
    "wave",
    "interaction",
    "hargold-double-jump",
    "hargold-ground-slam",
    "mebble-glide"
  ]
}
